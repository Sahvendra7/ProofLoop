# YouCam API (server-side only; never exposed to the browser).
# Leave blank to run with sample data only — live scans will then fail visibly.
YOUCAM_API_KEY=
YOUCAM_API_URL=https://yce-api-01.makeupar.com
# Verified live 2026-10-11. The docs also show POST /s2s/v2.0/file.
YOUCAM_FILE_PATH=/s2s/v2.0/file/{feature}

# Spend guards
PROVIDER_UNIT_BUDGET=400
LIVE_SCANS_PER_SESSION_PER_HOUR=6
SIMULATIONS_PER_SESSION_PER_HOUR=6

# Persistence. Defaults to SQLite at backend/proofloop.db for local development.
# Hosted: a PostgreSQL URL (postgres://, postgresql:// or postgresql+psycopg://), schema via `alembic upgrade head`.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# "production" refuses to start on SQLite (hosted disks are ephemeral).
APP_ENV=development

# Comma-separated
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Trial assistant. Quick answers work without any of this.
# Free text sends typed questions (never photos) to Google's Gemini API. Keep it false in production.
GEMINI_FREE_TEXT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=8
ASSISTANT_TURN_DEADLINE_S=15
ASSISTANT_ASKS_PER_SESSION_PER_HOUR=20
ASSISTANT_ASKS_PER_DAY=200
# SHA-256 (hex) of the prototype owner's access key. Free text stays off unless this is set; the key itself is
# never stored on the server. Generate a key, keep it private, and put only its hash here.
ASSISTANT_OWNER_TOKEN_SHA256=
